
clock {
    timezone PST+8PDT;
    starttime '2026-08-05 00:00:00';
    stoptime '2026-08-06 00:00:00';
}

#include "water_and_setpoint_schedule_v5.glm";
#include "appliance_schedules.glm";

module tape;
module climate;
object climate {
    name "WA-Pasco";
    tmyfile "WA-Pasco.tmy3";
    interpolate QUADRATIC;
};

module powerflow {
    solver_method NR;
}
module residential {
    implicit_enduses NONE;
}
module generators;

// Substation primary swing node (Phase A)
object node {
    name substation_node;
    phases AN;
    nominal_voltage 7200.0;
    bustype SWING;
}

// Center-tapped stepdown transformer (7200V -> 120/240V split-phase)
object transformer_configuration {
    name trans_config_1;
    connect_type SINGLE_PHASE_CENTER_TAPPED;
    install_type POLETOP;
    primary_voltage 7200.0;
    secondary_voltage 120.0;
    powerA_rating 75.0;
    impedance 0.006+0.0136j;
}

object transformer {
    name trans_1;
    phases AS;
    from substation_node;
    to house_meter_01;
    configuration trans_config_1;
}

// Triplex Meter (120/240V)
object triplex_meter {
    name house_meter_01;
    phases AS;
    nominal_voltage 120.0;
}

// Residential House
object house {
    name house_01;
    parent house_meter_01;
    floor_area 2200 sf;
    heating_setpoint 68 degF;
    cooling_setpoint 74 degF;
    thermostat_deadband 2.0;
    air_temperature 72.0;
    design_cooling_capacity 3.5 kW;

    // Responsive & Unresponsive Plugloads
    object ZIPload {
        name house_01_resp_load;
        base_power responsive_loads*1.20;
        heatgain_fraction 0.900;
        power_pf 1.000;
        current_pf 1.000;
        impedance_pf 1.000;
        impedance_fraction 0.200000;
        current_fraction 0.400000;
        power_fraction 0.400000;
    };

    // Water Heater with Diurnal Water Demand Schedule
    object waterheater {
        name wh_01;
        tank_volume 50.0;
        tank_setpoint 125.0;
        temperature 125.0;
        thermostat_deadband 4.0;
        heating_element_capacity 4.5 kW;
        location INSIDE;
        tank_UA 3.7;
        demand small_1*1.0;
    };

    // EV Charger Object
    object evcharger_det {
        name ev_01;
        charging_efficiency 0.92;
        mileage_classification 150.0;
        mileage_efficiency 3.5;
        maximum_charge_rate 7200.0;
        battery_size 60.0;
        battery_capacity 24.0;
        battery_SOC 40.0;
    };
}

// Inverter and Battery Storage
object inverter {
    name inv_battery_01;
    parent house_meter_01;
    generator_status ONLINE;
    generator_mode CONSTANT_PQ;
    inverter_type FOUR_QUADRANT;
    rated_power 5.0 kW;
    inverter_efficiency 0.95;
    P_Out 0.0;
    Q_Out 0.0;

    object battery {
        name battery_01;
        use_internal_battery_model TRUE;
        battery_type LI_ION;
        battery_capacity 13.5;
        state_of_charge 0.50;
        round_trip_efficiency 0.92;
    };
}
